---
import BaseLayout from '../layouts/BaseLayout.astro';

import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
---

<BaseLayout title="À propos | Enzo Petit" description="À propos d'Enzo Petit">
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero
				title="À Propos"
				tagline="Merci de vous être arrêté."
			>
				<br>
				Découvrez mon parcours professionnel.
				<img
					width="300"
					src="/assets/EnzoPetit1.jpg"
					alt="Photo D'Enzo en noir et blanc"
				/>
			</Hero>

			<section>
				<h2 class="section-title">Background</h2>
				<div class="content">
					<p>
						Développeur web polyvalent et architecte d'application, je conçois des produits digitaux de A à Z — de la structure fonctionnelle à l'intégration de l'intelligence artificielle. Fort d'une expérience de Product Builder, je m'attache à transformer des idées complexes en applications robustes et centrées sur l'utilisateur. 
					</p>
					<p>
						Curieux et orienté impact, je m'adapte rapidement à chaque contexte technologique pour livrer des solutions évolutives. Que ce soit en autonomie complète ou au sein d'une équipe, je privilégie toujours le mode de travail qui sert au mieux les objectifs du projet.
					</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Expérience</h2>
				<div class="content">
					<ul>
						<li><strong>Product Builder</strong>, Numit — Agence de Transformation Digitale (2025 - 2026)</li>
						<li><strong>Fondateur & Développeur</strong>, KeepTalking — Web App pédagogique (2026)</li>
						<li><strong>Développeur WordPress & Intégrateur Web</strong>, Freelance (2025)</li>
						<li><strong>Conseiller Numérique</strong>, Ville de Coutras (2022 - 2024)</li>
					</ul>
				</div>
			</section>

			<section>
				<h2 class="section-title">Education</h2>
				<div class="content">
					<ul>
						<li><strong>Licence • Concepteur Développeur d'Application</strong> (2026)</li>
						<li><strong>Product Builder & IA</strong>, Alegria (2026)</li>
						<li><strong>BTS Développeur Web</strong>, OpenClassroom (2024)</li>
						<li><strong>Conseiller Numérique</strong>, WebForce3 (2023)</li>
					</ul>
					<p>Certifications : Gestion de projet agile, React, JavaScript, HTML5/CSS3 (OpenClassroom).</p>
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	img {
		position: relative;
		left: 18%;
		margin-top: 1.5rem;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--gray-200);
	}

	.section-title {
		grid-column-start: 1;
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.content {
		grid-column: 2 / 4;
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		img {
			position: relative;
			left: 30%;
		}
		.about {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		.about > :global(:first-child) {
			grid-column-start: 2;
		}

		section {
			display: contents;
			font-size: var(--text-lg);
		}
		
	}
</style>
